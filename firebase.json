{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "config/firestore.rules",
    "indexes": "config/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "dist/functions",
      "codebase": "default",
      "predeploy": [
      ]
    }
  ],
  "hosting": {
    "public": "dist/viewer",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
