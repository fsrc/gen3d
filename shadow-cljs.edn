{:source-paths ["src/main"]

 :dependencies [[reagent "1.3.0" :exclusions [cljsjs/react cljsjs/react-dom]]
                [binaryage/devtools "1.0.6"]
                [babashka/process "0.1.7"]
                [cljs-http "0.1.46"]
                [noencore "0.3.7"]
                [funcool/promesa "8.0.450"]
                [reagent-utils "0.3.6"]
                [cljs-ajax "0.8.4"]
                [metosin/reitit "0.9.1"]
                [thedavidmeister/cljs-i18n "0.4.0"]]

 :nrepl {:port 25000}
 :builds {
          :viewer {:target :browser
                   :output-dir "dist/viewer/js"
                   :asset-path "js"
                   :modules {:main {:entries [gen3d.viewer.core]}}
                   :dev {:closure-defines {anr.fire.environment/EMULATOR true
                                           anr.fire.environment/REGION "europe-west1"}}

                   :release {:closure-defines {anr.fire.environment/EMULATOR false
                                               anr.fire.environment/REGION "europe-west1"}}

                   :devtools {
                              :before-load gen3d.viewer.core/stop
                              :after-load gen3d.viewer.core/start
                              :http-root "dist/viewer"
                              :http-port 8021}}

          :functions {:target :node-library
                      :main gen3d.functions.core
                      :output-to "dist/functions/index.js"
                      :exports-var gen3d.functions.core/exports
                      :dev {:closure-defines {anr.fire.environment/EMULATOR true}}
                      :release {:closure-defines {anr.fire.environment/EMULATOR false
                                                  anr.fire.environment/REGION "europe-west3"}}}
          :ai {:target :node-library
               :main gen3d.functions.ai
               :output-to "dist/functions/ai.js"
               :exports-var gen3d.functions.ai/exports
               :dev {:closure-defines {anr.fire.environment/EMULATOR true}}
               :release {:closure-defines {anr.fire.environment/EMULATOR false
                                           anr.fire.environment/REGION "europe-west3"}}}}}


